# Public example. Actual keys/accounts are intentionally absent.
# Copy locally to .env only when preparing your own isolated runtime.
AI_API_TIMEOUT_SECONDS=30
AI_AUDIO_DEVICE=plughw:CARD=USB,DEV=0
AI_COMMAND_POLL_SECONDS=5
AI_CONVERSATION_ENABLED=false
AI_CONVERSATION_TRIGGER=auto
AI_HISTORY_TURNS=10
AI_MAX_UTTERANCE_SECONDS=20
AI_MIN_SPEECH_MS=300
AI_PLAYBACK_DEVICE=plughw:CARD=USB,DEV=0
AI_PLAYBACK_TIMEOUT_SECONDS=45
AI_RECORD_SECONDS=5
AI_SESSION_IDLE_SECONDS=300
AI_SESSION_MAX_NO_SPEECH=2
AI_SESSION_MAX_TURNS=5
AI_SPEECH_SILENCE_SECONDS=1.8
AI_SPEECH_START_TIMEOUT_SECONDS=4
AI_WAKE_WORD_ENABLED=false
AI_WAKE_WORD_LOG_TRANSCRIPTS=false
# Optional; leave unset until needed: AI_WAKE_WORD_MODEL_PATH=
AI_WAKE_WORD_PHRASES=도란아
DEVICE_ID=device_001
DISPLAY_ENABLED=false
DISPLAY_HOST=127.0.0.1
DISPLAY_PORT=8765
ELDER_ID=elder_001
FIREBASE_DATABASE_URL=
FIREBASE_RUNTIME_MODE=legacy
LOCATION_NAME=거실
MEDICATION_SCHEDULE_POLL_SECONDS=15
MEDICATION_TIMES=08:00,12:00,19:00
MEDICATION_VOICE_CONFIRMATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_SPEED=1.15
OPENAI_TTS_VOICE=cedar
REMINDER_MODE=demo
